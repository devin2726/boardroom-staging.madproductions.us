# Coolify fills SERVICE_* automatically (magic variables). Set these only for local runs.
SERVICE_FQDN_WORDPRESS=http://localhost:8080
SERVICE_USER_MYSQL=boardroom
SERVICE_PASSWORD_MYSQL=change-me
SERVICE_PASSWORD_ROOT=change-me-root
MYSQL_DATABASE=boardroom
# Optional: set the WP admin password on first boot (user "admin"); change after login anyway
WP_ADMIN_PASSWORD=
WP_ADMIN_EMAIL=
# Leave empty. Empty means production. Do not put staging here: this file is shared,
# and production uses the same compose file. The staging Coolify app must set
# BRB_ENV=staging in that app's own environment variables. dev and test are the
# other non-production values. A typo is production. boardroomqc.com is always production.
BRB_ENV=
# Optional HTTP basic auth when BRB_ENV is staging, dev, or test. Both must be set or the prompt stays off.
# wp-cron, the Stripe webhook, and a logged-in administrator skip it. Production ignores these.
BRB_STAGING_USER=
BRB_STAGING_PASS=
# Public site URL. Leave empty to follow WP_HOME / SERVICE_FQDN_WORDPRESS.
WP_SITEURL=
# 1 = noindex on staging/dev/test. 0 = allow indexing there too.
# Production (and an empty or misspelled BRB_ENV) indexes the site. Staging should leave this at 1. Production sets 0.
DISCOURAGE_SEARCH=1
# WordPress salts. Leave empty outside production; empty values are not written as blank secrets.
# Production should set all eight. Do not commit the values.
WORDPRESS_AUTH_KEY=
WORDPRESS_SECURE_AUTH_KEY=
WORDPRESS_LOGGED_IN_KEY=
WORDPRESS_NONCE_KEY=
WORDPRESS_AUTH_SALT=
WORDPRESS_SECURE_AUTH_SALT=
WORDPRESS_LOGGED_IN_SALT=
WORDPRESS_NONCE_SALT=
# Outbound SMTP. Mail stays on WordPress's default transport until USER and PASS are both set.
# Set these in Coolify. Do not commit a password.
BRB_SMTP_HOST=smtp.gmail.com
BRB_SMTP_PORT=587
BRB_SMTP_USER=
BRB_SMTP_PASS=
BRB_SMTP_FROM=boardroomqc@gmail.com
BRB_SMTP_FROM_NAME=The Boardroom
# Optional card payments. Online payment stays off until the secret key is set. Do not commit keys.
BRB_STRIPE_SECRET_KEY=
BRB_STRIPE_WEBHOOK_SECRET=
BRB_STRIPE_PUBLISHABLE_KEY=
